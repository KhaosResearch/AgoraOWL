# MUST FAIL: OWL reasoning. mapsToSpecification is functional in v1.3.0, and the
# two specifications are asserted to be different individuals, so a FieldMapping
# pointing at both is inconsistent.
@prefix :     <https://w3id.org/AgoraOWL/> .
@prefix ex:   <http://example.org/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<http://example.org/negative/two-specifications> rdf:type owl:Ontology ;
    owl:imports <https://w3id.org/AgoraOWL/> .

ex:SpecA rdf:type :DataSpecification .
ex:SpecB rdf:type :DataSpecification .
[] rdf:type owl:AllDifferent ;
   owl:distinctMembers ( ex:SpecA ex:SpecB ) .

ex:Mapping rdf:type :FieldMapping ;
    :mapsField "temp_c" ;
    :mapsToSpecification ex:SpecA , ex:SpecB .
